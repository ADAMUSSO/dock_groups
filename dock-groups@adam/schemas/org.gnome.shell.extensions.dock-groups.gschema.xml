<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.dock-groups" path="/org/gnome/shell/extensions/dock-groups/">
    <key name="groups" type="s">
      <default>'[]'</default>
      <summary>Application groups (JSON)</summary>
      <description>List of objects {id, name, apps: [desktop-id, ...]}</description>
    </key>
    <key name="state" type="s">
      <default>'{}'</default>
      <summary>Internal state (which groups and members have already been applied to the dock)</summary>
    </key>
    <key name="remove-members-from-dock" type="b">
      <default>true</default>
      <summary>Remove applications from their own dock slots when they are added to a group</summary>
    </key>
    <key name="icon-size" type="i">
      <range min="32" max="128"/>
      <default>64</default>
      <summary>Icon size in the group popup</summary>
    </key>
    <key name="columns" type="i">
      <range min="0" max="8"/>
      <default>0</default>
      <summary>Number of columns (0 = automatic)</summary>
    </key>
    <key name="show-labels" type="b">
      <default>true</default>
      <summary>Show application names</summary>
    </key>
    <key name="animation-speed" type="d">
      <range min="0.25" max="3.0"/>
      <default>1.0</default>
      <summary>Animation duration multiplier</summary>
    </key>
    <key name="theme" type="s">
      <choices>
        <choice value="auto"/>
        <choice value="light"/>
        <choice value="dark"/>
      </choices>
      <default>'auto'</default>
      <summary>Popup color theme</summary>
      <description>'auto' follows the system color scheme, 'light' and 'dark' force a theme.</description>
    </key>
  </schema>
</schemalist>
